FROM docker.io/library/golang:1.27.4-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends shellcheck=0.9.0-1 \
    && rm -rf /var/lib/apt/lists/*

ENV GOTOOLCHAIN=local \
    CGO_ENABLED=1

RUN go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.15.0 \
    && go install github.com/mfenderov/gocrap@v0.4.2 \
    && go install golang.org/x/vuln/cmd/govulncheck@v1.9.0 \
    && rm -rf /go/pkg/mod /root/.cache/go-build

ENV GOFLAGS=-mod=readonly \
    GOCACHE=/tmp/go-build \
    GOMODCACHE=/tmp/go-mod \
    GOLANGCI_LINT_CACHE=/tmp/golangci-lint

WORKDIR /workspace
